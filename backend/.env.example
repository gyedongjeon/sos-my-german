# Optional settings for running the backend from this checkout.
#
#   cp .env.example .env        # .env is git-ignored
#   uv run --env-file .env uvicorn app.main:app --reload
#   uv run --env-file .env pytest -m live      # the tests that call a real model
#
# This file is committed: never put a real key in it. Real keys go in .env only.
#
# Note: LiteLLM also loads a .env file from the folder the backend is started in, so a server
# started in backend/ picks this file up even without --env-file.
#
# A model and key saved on the app's Settings page take priority over the ones here, so these
# are used when nothing is saved there (for example with a fresh data folder).

# The model, written as "<provider>/<model>" the way LiteLLM names it.
LLM_MODEL=gemini/gemini-3.1-flash-lite

# The API key of that provider. LiteLLM reads the variable that belongs to the provider;
# fill in the one you use and leave the others empty.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Language the corrections are explained in, as an English name, when none is chosen in Settings.
# FEEDBACK_LANGUAGE=Korean

# Speech-to-text model (default: small, which knows German; the ".en" ones do not) and your
# partner's Piper voice (default: de_DE-thorsten-high; see huggingface.co/rhasspy/piper-voices).
# WHISPER_MODEL=small
# TTS_VOICE=de_DE-thorsten-high   (a voice chosen under Settings comes first)

# Where the app keeps its files (default: backend/data).
# SOS_MY_GERMAN_DATA_DIR=
